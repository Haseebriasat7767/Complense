{
  "name": "@complylens/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "verify:demo": "tsx scripts/verify-demo.ts"
  },
  "dependencies": {
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2"
  },
  "optionalDependencies": {
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
