# =============================================================================
# ComplyLens AI — environment variables (example)
# =============================================================================
# Copy this file to `.env` and adjust. Every value below is OPTIONAL.
# ComplyLens runs fully in DEMO MODE with an empty .env — no API keys required.
#
#   cp .env.example .env
#
# -----------------------------------------------------------------------------
# 1. Runtime
# -----------------------------------------------------------------------------
# NODE_ENV=development            # development | production
# PORT=4000                       # single port serves the API + the web app
# HOST=0.0.0.0                    # bind address (use 0.0.0.0 in containers)
# TRUST_PROXY_HOPS=0              # exact trusted proxy count; keep 0 unless behind a proxy

# -----------------------------------------------------------------------------
# 2. Demo mode
# -----------------------------------------------------------------------------
# When DEMO_MODE=true (default when AUTH_REQUIRED is false) the app seeds the
# fictional "AcmeCloud" sample workspace and the "Try Demo" button issues a
# session without credentials.
# DEMO_MODE=true
# AUTH_REQUIRED=false             # true => /app requires a real session

# -----------------------------------------------------------------------------
# 3. Sessions
# -----------------------------------------------------------------------------
# HS256 signing secret. If unset, a random per-boot development secret is used
# (sessions are invalidated on restart). ALWAYS set this in production.
# SESSION_SECRET=replace-with-a-long-random-string
# SESSION_TTL_HOURS=12

# -----------------------------------------------------------------------------
# 4. Database — Supabase PostgreSQL
# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. The server refuses to start in production without
# these: an in-memory fallback would silently discard every upload, report and
# account. Locally you can leave them empty to run on the in-memory demo store.
#
# Both values are SERVER-SIDE ONLY. Never prefix them with VITE_ or
# NEXT_PUBLIC_ and never commit real values — the secret key bypasses RLS.
#
#   Project Settings -> Data API  -> Project URL
#   Project Settings -> API Keys  -> secret key (sb_secret_..., aka service_role)
#
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_replace_me
#
# Legacy alias, still accepted if you already use it:
# SUPABASE_SERVICE_ROLE_KEY=
#
# Optional Supabase tuning:
# SUPABASE_DB_SCHEMA=public            # schema holding the ComplyLens tables
# SUPABASE_EVIDENCE_BUCKET=evidence    # private bucket for original uploads
# SUPABASE_TIMEOUT_MS=10000            # abort any Supabase request after this
# EVIDENCE_RETAIN_ORIGINAL_FILES=true  # false => keep extracted text only
#
# Store selection:
#   auto     (default) Supabase when configured, memory otherwise (non-prod)
#   supabase force the persistent store; fail fast if it is unavailable
#   memory   explicit in-memory store. REFUSED in production.
# STORE_DRIVER=auto
#
# Only used by `npm run db:migrate` (applying supabase/migrations/) and never
# by the running server. Use the direct or SESSION pooler URI on port 5432 —
# the transaction pooler (6543) cannot run DDL reliably.
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# 5. AI provider (optional)
# -----------------------------------------------------------------------------
# Without a provider the deterministic local analysis engine is used and the UI
# shows "Demo Analysis Mode". No call ever fails because a key is missing.
#
# AI_PROVIDER=openai-compatible        # openai-compatible | none
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=20000
#
# Safety switch: external AI is only used when explicitly enabled AND a key is
# present. Evidence text is never sent to a provider unless both are true.
# AI_ALLOW_EXTERNAL=false

# -----------------------------------------------------------------------------
# 6. Uploads
# -----------------------------------------------------------------------------
# Default 10 MB in a container/Node deployment and 4 MB when the app runs as a
# serverless function (Vercel rejects request bodies above ~4.5 MB before the
# application sees them). Set MAX_UPLOAD_MB explicitly to override both.
# MAX_UPLOAD_MB=10
# ALLOWED_UPLOAD_TYPES=pdf,docx,txt,csv

# -----------------------------------------------------------------------------
# 7. Cross-origin access (optional)
# -----------------------------------------------------------------------------
# Leave empty for the default same-origin deployment (API + client on one port).
# Set a comma-separated allowlist when the web client is hosted elsewhere, e.g.
# a Vercel deployment calling this API. Use * only for throwaway demos.
# CORS_ORIGINS=https://complylens.vercel.app,https://preview-abc.vercel.app

# -----------------------------------------------------------------------------
# 8. Client build-time variables (Vite, prefixed with VITE_)
# -----------------------------------------------------------------------------
# The client talks to the same origin by default. Set this only when the API is
# hosted on a different origin, e.g. https://api.example.com
# VITE_API_BASE_URL=
