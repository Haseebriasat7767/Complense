# =============================================================================
# ComplyLens AI — environment variables (example)
# =============================================================================
# Copy this file to `.env` and adjust. Every value below is OPTIONAL.
# ComplyLens runs fully in DEMO MODE with an empty .env — no API keys required.
#
#   cp .env.example .env
#
# -----------------------------------------------------------------------------
# 1. Runtime
# -----------------------------------------------------------------------------
# NODE_ENV=development            # development | production
# PORT=4000                       # single port serves the API + the web app
# HOST=0.0.0.0                    # bind address (use 0.0.0.0 in containers)
# PUBLIC_APP_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# 2. Demo mode
# -----------------------------------------------------------------------------
# When DEMO_MODE=true (default when AUTH_REQUIRED is false) the app seeds the
# fictional "AcmeCloud" sample workspace and the "Try Demo" button issues a
# session without credentials.
# DEMO_MODE=true
# AUTH_REQUIRED=false             # true => /app requires a real session

# -----------------------------------------------------------------------------
# 3. Sessions
# -----------------------------------------------------------------------------
# HS256 signing secret. If unset, a random per-boot development secret is used
# (sessions are invalidated on restart). ALWAYS set this in production.
# SESSION_SECRET=replace-with-a-long-random-string
# SESSION_TTL_HOURS=12

# -----------------------------------------------------------------------------
# 4. Database (optional)
# -----------------------------------------------------------------------------
# Leave empty to run on the built-in in-memory demo store (zero setup).
# Set to a MongoDB connection string to persist organizations, users, evidence,
# control assessments and reports.
# MONGODB_URI=mongodb://127.0.0.1:27017/complylens
# MONGODB_DB=complylens

# -----------------------------------------------------------------------------
# 5. AI provider (optional)
# -----------------------------------------------------------------------------
# Without a provider the deterministic local analysis engine is used and the UI
# shows "Demo Analysis Mode". No call ever fails because a key is missing.
#
# AI_PROVIDER=openai-compatible        # openai-compatible | none
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
#
# Safety switch: external AI is only used when explicitly enabled AND a key is
# present. Evidence text is never sent to a provider unless both are true.
# AI_ALLOW_EXTERNAL=false

# -----------------------------------------------------------------------------
# 6. Uploads
# -----------------------------------------------------------------------------
# Default 10 MB in a container/Node deployment and 4 MB when the app runs as a
# serverless function (Vercel rejects request bodies above ~4.5 MB before the
# application sees them). Set MAX_UPLOAD_MB explicitly to override both.
# MAX_UPLOAD_MB=10
# ALLOWED_UPLOAD_TYPES=pdf,docx,txt,csv

# -----------------------------------------------------------------------------
# 7. Cross-origin access (optional)
# -----------------------------------------------------------------------------
# Leave empty for the default same-origin deployment (API + client on one port).
# Set a comma-separated allowlist when the web client is hosted elsewhere, e.g.
# a Vercel deployment calling this API. Use * only for throwaway demos.
# CORS_ORIGINS=https://complylens.vercel.app,https://preview-abc.vercel.app

# -----------------------------------------------------------------------------
# 8. Client build-time variables (Vite, prefixed with VITE_)
# -----------------------------------------------------------------------------
# The client talks to the same origin by default. Set this only when the API is
# hosted on a different origin, e.g. https://api.example.com
# VITE_API_BASE_URL=
# VITE_APP_NAME=ComplyLens AI
